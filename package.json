{
  "name": "herakles",
  "version": "2.0.0",
  "description": "A Bun-first workspace orchestrator for many repositories.",
  "type": "module",
  "bin": {
    "herakles": "./bin/herakles"
  },
  "scripts": {
    "herakles": "bun run src/cli/main.ts",
    "build": "bun run scripts/build.ts",
    "build:cli": "bun run scripts/build.ts cli",
    "test": "bun test",
    "format": "biome format --write .",
    "lint": "biome check .",
    "quality": "fallow audit --gate new-only && fallow health --score --report-only"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frostney/herakles.git"
  },
  "keywords": [
    "git",
    "github",
    "repository",
    "workspace",
    "bun"
  ],
  "author": "Johannes Stein",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/frostney/herakles/issues"
  },
  "homepage": "https://github.com/frostney/herakles#readme",
  "dependencies": {
    "@stricli/core": "^1.2.7",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.4",
    "fallow": "^3.33.1",
    "typescript": "7.0.2"
  }
}
