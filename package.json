{
  "name": "herakles",
  "version": "2.0.0",
  "description": "A Bun-first workspace orchestrator for many repositories.",
  "type": "module",
  "bin": {
    "herakles": "./src/cli/main.ts",
    "herakles-ui": "./src/ui/server/main.ts"
  },
  "scripts": {
    "herakles": "bun run src/cli/main.ts",
    "ui": "bun run src/ui/server/main.ts",
    "desktop": "electrobun dev",
    "desktop:build": "electrobun build --env=stable",
    "desktop:build:nightly": "electrobun build --env=canary",
    "test": "bun test",
    "format": "biome format --write .",
    "lint": "biome check .",
    "quality": "fallow audit --gate new-only && fallow health --score --report-only"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frostney/herakles.git"
  },
  "keywords": ["git", "github", "repository", "workspace", "automation", "bun"],
  "author": "Johannes Stein",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/frostney/herakles/issues"
  },
  "homepage": "https://github.com/frostney/herakles#readme",
  "dependencies": {
    "@stricli/core": "^1.2.7",
    "@tanstack/react-router": "^1.131.48",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.1.14",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "bun-plugin-tailwind": "^0.1.2",
    "electrobun": "1.18.1",
    "fallow": "^2.32.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.7.2"
  }
}
